PORT=3001

# Base de datos. Si se define, usa Postgres (Neon); si no, usa sqlite local (wg.db)
# DATABASE_URL=postgresql://user:password@host.region.aws.neon.tech/neondb
# PGSSL=true

# JWT - clave secreta para firmar tokens de sesión admin
# JWT_SECRET=generar_una_clave_larga_y_secreta

# URL pública de la app (se usa para el enlace de baja en los correos)
# PUBLIC_URL=http://localhost:3001

# Configuración SMTP para enviar correos del newsletter (Gmail / App Password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu.correo@gmail.com
# SMTP_PASS=tu_app_password_de_16_caracteres
# MAIL_FROM=WG <tu.correo@gmail.com>